{
  "name": "crm-agc",
  "version": "0.2.0",
  "private": true,
  "description": "ERP nội bộ Công ty TNHH Alpha Green Commerce",
  "type": "module",
  "scripts": {
    "cai-dat": "node scripts/cai-dat.mjs",
    "tao-tai-khoan": "node scripts/tao-tai-khoan.mjs",
    "nap-db-may": "wrangler d1 execute crm-agc --local --file=schema.sql && wrangler d1 execute crm-agc --local --file=seed.sql",
    "nap-db": "wrangler d1 execute crm-agc --remote --file=schema.sql && wrangler d1 execute crm-agc --remote --file=seed.sql",
    "nap-kho-may": "wrangler d1 execute crm-agc --local --file=migrations/them-kho.sql",
    "nap-kho": "wrangler d1 execute crm-agc --remote --file=migrations/them-kho.sql",
    "nap-kho-mau-may": "wrangler d1 execute crm-agc --local --file=migrations/kho-mau.sql",
    "nap-kho-mau": "wrangler d1 execute crm-agc --remote --file=migrations/kho-mau.sql",
    "nap-shopee-may": "wrangler d1 execute crm-agc --local --file=migrations/them-shopee.sql",
    "nap-shopee": "wrangler d1 execute crm-agc --remote --file=migrations/them-shopee.sql",
    "nap-tiktok-may": "wrangler d1 execute crm-agc --local --file=migrations/them-tiktok.sql",
    "nap-tiktok": "wrangler d1 execute crm-agc --remote --file=migrations/them-tiktok.sql",
    "nap-hoso-may": "wrangler d1 execute crm-agc --local --file=migrations/them-hoso-nhansu.sql",
    "nap-hoso": "wrangler d1 execute crm-agc --remote --file=migrations/them-hoso-nhansu.sql",
    "nap-tinhtranghang-may": "wrangler d1 execute crm-agc --local --file=migrations/them-tinhtrang-hang.sql",
    "nap-tinhtranghang": "wrangler d1 execute crm-agc --remote --file=migrations/them-tinhtrang-hang.sql",
    "nap-doisoat-may": "wrangler d1 execute crm-agc --local --file=migrations/them-doisoat.sql",
    "nap-doisoat": "wrangler d1 execute crm-agc --remote --file=migrations/them-doisoat.sql",
    "nap-donhang-may": "wrangler d1 execute crm-agc --local --file=migrations/them-donhang.sql",
    "nap-donhang": "wrangler d1 execute crm-agc --remote --file=migrations/them-donhang.sql",
    "nap-muctieu-may": "wrangler d1 execute crm-agc --local --file=migrations/them-muctieu.sql",
    "nap-muctieu": "wrangler d1 execute crm-agc --remote --file=migrations/them-muctieu.sql",
    "nap-schemamigrations-may": "wrangler d1 execute crm-agc --local --file=migrations/them-schema-migrations.sql",
    "nap-schemamigrations": "wrangler d1 execute crm-agc --remote --file=migrations/them-schema-migrations.sql",
    "migration-kiemtra": "node scripts/kiem-tra-migration.mjs",
    "migration-kiemtra-may": "node scripts/kiem-tra-migration.mjs --local",
    "migration-chay": "node scripts/chay-migration.mjs",
    "nap-saoluu-may": "wrangler d1 execute crm-agc --local --file=migrations/them-sao-luu.sql",
    "nap-saoluu": "wrangler d1 execute crm-agc --remote --file=migrations/them-sao-luu.sql",
    "lay-khoa-google": "node scripts/lay-khoa-google.mjs",
    "sao-luu-thu": "node scripts/thu-sao-luu.mjs",
    "sao-luu-kiemtra": "node scripts/kiem-tra-ban-sao-luu.mjs",
    "chay": "wrangler dev",
    "dua-len": "wrangler deploy"
